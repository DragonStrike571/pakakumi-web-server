NODE_ENV=development
HOST=0.0.0.0
PORT=8000
# Set to the exact number of reverse proxies (e.g. 1 for a single Nginx proxy).
# Keep 0 when clients connect directly to the server.
TRUST_PROXY_HOPS=0

DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
BETTER_AUTH_SECRET=replace_with_a_high_entropy_secret
BETTER_AUTH_URL=http://localhost:8000
ENCRYPTION_KEY=replace_with_exactly_64_hex_characters
CORS_ORIGINS=http://localhost:3000

PAKAKUMI_URL=https://play.pakakumi.com
HEADLESS=true
PLAYWRIGHT_DISABLE_SANDBOX=false
AUTO_PLAY_ENABLED=true

# Optional services. Leave unset to disable them cleanly.
TELEGRAM_BOT_TOKEN=
PUBLIC_CHANNEL_ID=
PRIVATE_CHANNEL_ID=
ADMIN_CHANNEL_ID=
PAYSTACK_SECRET_KEY=
COLLECTION_DATA_DIR=./data
